	"tokenColors": [
		{
			"name": "Comment",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#8C919B",
				"fontStyle": "italic"
			}
		},
		{
			"name": "String",
			"scope": [
				"string",
				"string.quoted",
				"constant.other.symbol"
			],
			"settings": {
				"foreground": "#3F6B4F"
			}
		},
		{
			"name": "String escape",
			"scope": [
				"constant.character.escape"
			],
			"settings": {
				"foreground": "#8A5A2B"
			}
		},
		{
			"name": "Number",
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character"
			],
			"settings": {
				"foreground": "#8A5A2B"
			}
		},
		{
			"name": "Keyword",
			"scope": [
				"keyword",
				"keyword.control",
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#3B5A8C"
			}
		},
		{
			"name": "Function",
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call"
			],
			"settings": {
				"foreground": "#26282D"
			}
		},
		{
			"name": "Variable",
			"scope": [
				"variable",
				"variable.parameter",
				"meta.definition.variable"
			],
			"settings": {
				"foreground": "#3A3E45"
			}
		},
		{
			"name": "Type",
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class"
			],
			"settings": {
				"foreground": "#3F6B6B"
			}
		},
		{
			"name": "Tag",
			"scope": [
				"entity.name.tag",
				"punctuation.definition.tag"
			],
			"settings": {
				"foreground": "#3B5A8C"
			}
		},
		{
			"name": "Attribute",
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#8A5A2B"
			}
		},
		{
			"name": "Operator",
			"scope": [
				"keyword.operator",
				"punctuation"
			],
			"settings": {
				"foreground": "#6A6F79"
			}
		},
		{
			"name": "Invalid",
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#B03A3A"
			}
		}
	],
	"semanticTokenColors": {
		"class": "#3F6B6B",
		"interface": "#3F6B6B",
		"enum": "#3F6B6B",
		"function": "#26282D",
		"method": "#26282D",
		"variable": "#3A3E45",
		"parameter": "#3A3E45",
		"property": "#3A3E45",
		"keyword": "#3B5A8C",
		"string": "#3F6B4F",
		"number": "#8A5A2B",
		"comment": "#8C919B"
	},
	"semanticHighlighting": true
}
