	"tokenColors": [
		{
			"name": "Comment",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#5F5142",
				"fontStyle": "italic"
			}
		},
		{
			"name": "String",
			"scope": [
				"string",
				"string.quoted",
				"constant.other.symbol"
			],
			"settings": {
				"foreground": "#C4B07A"
			}
		},
		{
			"name": "String escape",
			"scope": [
				"constant.character.escape"
			],
			"settings": {
				"foreground": "#E0A05F"
			}
		},
		{
			"name": "Number",
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character"
			],
			"settings": {
				"foreground": "#E0A05F"
			}
		},
		{
			"name": "Keyword",
			"scope": [
				"keyword",
				"keyword.control",
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#D08843"
			}
		},
		{
			"name": "Function",
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call"
			],
			"settings": {
				"foreground": "#E6D7C2"
			}
		},
		{
			"name": "Variable",
			"scope": [
				"variable",
				"variable.parameter",
				"meta.definition.variable"
			],
			"settings": {
				"foreground": "#CBBBA6"
			}
		},
		{
			"name": "Type",
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class"
			],
			"settings": {
				"foreground": "#C9A87F"
			}
		},
		{
			"name": "Tag",
			"scope": [
				"entity.name.tag",
				"punctuation.definition.tag"
			],
			"settings": {
				"foreground": "#D08843"
			}
		},
		{
			"name": "Attribute",
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#E0A05F"
			}
		},
		{
			"name": "Operator",
			"scope": [
				"keyword.operator",
				"punctuation"
			],
			"settings": {
				"foreground": "#8A7660"
			}
		},
		{
			"name": "Invalid",
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#D9736B"
			}
		}
	],
	"semanticTokenColors": {
		"class": "#C9A87F",
		"interface": "#C9A87F",
		"enum": "#C9A87F",
		"function": "#E6D7C2",
		"method": "#E6D7C2",
		"variable": "#CBBBA6",
		"parameter": "#CBBBA6",
		"property": "#CBBBA6",
		"keyword": "#D08843",
		"string": "#C4B07A",
		"number": "#E0A05F",
		"comment": "#5F5142"
	},
	"semanticHighlighting": true
}
