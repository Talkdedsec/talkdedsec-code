#include <windows.h>
#include "version.h"

1 ICON "code.ico"
1 RT_MANIFEST "kurulum.manifest"
101 RCDATA "logo.png"
102 RCDATA "core.exe"

VS_VERSION_INFO VERSIONINFO
FILEVERSION TLK_VERSION_NUM
PRODUCTVERSION TLK_VERSION_NUM
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "Talkdedsec"
			VALUE "FileDescription", "Talkdedsec Setup"
			VALUE "FileVersion", TLK_VERSION_STR
			VALUE "LegalCopyright", "Copyright (C) Talkdedsec"
			VALUE "OriginalFilename", "TalkdedsecSetup.exe"
			VALUE "ProductName", "Talkdedsec"
			VALUE "ProductVersion", TLK_VERSION_STR
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
